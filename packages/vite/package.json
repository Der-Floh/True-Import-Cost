{
    "name": "@true-import-cost/vite",
    "version": "1.0.0",
    "description": "Vite plugin that records what your production build contains, for the True Import Cost VS Code extension",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Der-Floh/True-Import-Cost.git",
        "directory": "packages/vite"
    },
    "homepage": "https://github.com/Der-Floh/True-Import-Cost/tree/main/packages/vite#readme",
    "bugs": {
        "url": "https://github.com/Der-Floh/True-Import-Cost/issues"
    },
    "keywords": [
        "vite",
        "vite-plugin",
        "rollup",
        "rolldown",
        "bundle size",
        "import cost",
        "metafile",
        "true-import-cost"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "peerDependencies": {
        "vite": ">=5.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
