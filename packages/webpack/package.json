{
    "name": "@true-import-cost/webpack",
    "version": "1.0.0",
    "description": "webpack and Rspack plugin that records what your production build contains, for the True Import Cost VS Code extension",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Der-Floh/True-Import-Cost.git",
        "directory": "packages/webpack"
    },
    "homepage": "https://github.com/Der-Floh/True-Import-Cost/tree/main/packages/webpack#readme",
    "bugs": {
        "url": "https://github.com/Der-Floh/True-Import-Cost/issues"
    },
    "keywords": [
        "webpack",
        "webpack-plugin",
        "rspack",
        "rspack-plugin",
        "bundle size",
        "import cost",
        "stats",
        "true-import-cost"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "peerDependencies": {
        "@rspack/core": ">=1.0.0",
        "webpack": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "@rspack/core": {
            "optional": true
        },
        "webpack": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
